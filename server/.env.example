# Port the sync server listens on.
PORT=4000

# Where workspace JSON files are stored. Mount this as a persistent volume
# in production or every deploy will wipe all synced workspaces.
DATA_DIR=/data

# Comma-separated list of origins allowed to call this API, e.g.
# https://yourname.github.io,https://pm-ops.example.com
# Use * to allow any origin (fine for a personal/demo deployment).
ALLOWED_ORIGINS=*
